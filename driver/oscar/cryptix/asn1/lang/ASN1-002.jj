/*@egen*/
}

int Clazz(): {
}{
    <UNIVERSAL>
        {
            return Tag.UNIVERSAL;
        }
|   <APPLICATION>
        {
            return Tag.APPLICATION;
        }
|   <PRIVATE>
        {
            return Tag.PRIVATE;
        }
}

int ClassNumber(): {
    Token t;
}{
    t = <NUMBER>
        {
            return Integer.parseInt(t.image);
        }
|   DefinedValue()
        {
            return Integer.parseInt((String) stack[top--]);
        }
}

boolean Tagging(): {}
{
    <EXPLICIT>
        {
            return true;
        }
|   <IMPLICIT>
        {
            return false;
        }
}

