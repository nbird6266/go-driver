void NamedNumberList(): {
}{
    NamedNumber() ("," NamedNumber())*
}

void NamedNumber(): {
    String id;
    BigInteger val;
}{
    id = Identifier()
    "("
    (   val = SignedNumber()
    |    DefinedValue()
        {
            val = (BigInteger) stack[top--];
        }
    )
        {
            sTable.put(id, val);
        }
    ")"
}

BigInteger SignedNumber(): {
    Token t;
    String image = "";
}{
    [   "-"
        {
            image = "-";
        }
    ] t = <NUMBER>
        {
            image += t.image;
            return new BigInteger(image);
        }
}

