// VALUES
//===========================================================================

//void Value(): {
Object Value(): {
    Object result = null;
}{
    LOOKAHEAD(2) result = BuiltInValue()
        {
            return result;
        }
|   result = DefinedValue()
        {
            return result;
        }
}

//void BuiltInValue(): {
Object BuiltInValue(): {
    boolean b;
    BigInteger bi;
    byte[] ba;
    String s;
    Vector v;
}{
    b = Boolean()
        {
            return new Boolean(b);
        }
|   LOOKAHEAD(2) bi = Integer()
        {
            return bi;
        }
|   ba = OctetString()
        {
            return ba;
        }
|   Null()
        {
            return null;
        }
|   LOOKAHEAD(2) s = ObjectIdentifier()
        {
            return s;
        }
|   v = Sequence()
        {
            return v;
        }
|   s = CharacterString()
        {
            return s;
        }
}

Object DefinedValue(): {
    String id;
}{
    id = ValueReference()
        {
            if (!sTable.containsKey(id)) // look it up in active symtable
                throw new ParseException("Undefined Value: "+id);
            Object result = sTable.get(id);
            stack[++top] = result;
            return result;
        }
}

// --------------------------------------------------------------------------

boolean Boolean(): {
}{
    <TRUE>
        {
            return true;
        }
|    <FALSE>
        {
            return false;
        }
}

// --------------------------------------------------------------------------

BigInteger Integer(): {
    BigInteger result;
    String id;
}{
    result = SignedNumber()
        {
            return result;
        }
|   id = Identifier()
        {
            if (!sTable.containsKey(id))
                throw new ParseException("Undefined Identifer: "+id);
            return (BigInteger) sTable.get(id);
        }
}

// --------------------------------------------------------------------------

byte[] OctetString(): {
    Token t;
    String image;
    BigInteger result;
}{
    t = <B_STRING>
        {
            // bit strings start with ' and end with 'B
            image = t.image.substring(1, t.image.length() - 2);
            result = new BigInteger(image, 2);
            return result.toByteArray();
        }
|   t = <H_STRING>
        {
            // bit strings start with ' and end with 'H
            image = t.image.substring(1, t.image.length() - 2);
            result = new BigInteger(image, 16);
            return result.toByteArray();
        }
}

// --------------------------------------------------------------------------

void Null(): {}
{
    <NULL>
}

// --------------------------------------------------------------------------

String ObjectIdentifier(): {
    int m = top;      // index of top of the runtime stack
}{
    "{"
    (
        LOOKAHEAD(2)
        DefinedValue() ObjIdComponent()
    |
        ObjIdComponent()
    )
    (ObjIdComponent())*
    "}"
        {
            // pop the runtime stack building the OID data as a
            // dot-separated-String
            int limit = top;
            String it = "";
            boolean virgin = true;
            while (m < limit) {
                it += (virgin ? "" : ".") + (String) stack[++m];
                virgin = false;
            }
            top = m;
            return it;
        }
}

void ObjIdComponent(): {
    String id;
}{
    LOOKAHEAD(2) id = Identifier() "(" NumberForm() ")"
        {
            // install this id in the current symtable but leave its
            // value on the stack.
            sTable.put(id, (String) stack[top]);
        }
|   LOOKAHEAD(2) id = Identifier()
        {
            // assume we already defined the Identifier. get its value
            // from the symtable and push it on the stack. should test
            // if value exists, otherwise user is referring to an
            // undefined id.
            if (!sTable.containsKey(id))
                throw new ParseException("Undefined Identifer: "+id);
            stack[++top] = (String) sTable.get(id);
        }
|   NumberForm()
}

void NumberForm(): {
	Token t;
}{
    t = <NUMBER>
        {
            stack[++top] = t.image; // just push it on the stack
        }
|   DefinedValue()
}

// --------------------------------------------------------------------------

//void Sequence(): {
Vector Sequence(): {
    Vector result = new Vector();
}{
    "{" [ ElementValueList(result) ] "}"
        {
            return result;
        }
}

void ElementValueList(Vector sequence): {
}{
    NamedValue(sequence) ("," NamedValue(sequence))*
}

void NamedValue(Vector container): {
    Object val;
}{
    LOOKAHEAD(2) Identifier() val = Value()
        {
            container.addElement(val);
        }
|   val = Value()
        {
            container.addElement(val);
        }
}

// --------------------------------------------------------------------------

String CharacterString(): {
    Token t;
}{
    t = <C_STRING>
        {
            // bit strings start and end with '
            return t.image.substring(1, t.image.length() - 1);
        }
}

// ==========================================================================

String TypeReference(): {
    Token t;
}{
    t = <UPPER>
        {
            return t.image;
        }
}

String Identifier(): {
    Token t;
}{
    t = <LOWER>
        {
            return t.image;
        }
}

String ValueReference(): {
    Token t;
}{
    t = <LOWER>
        {
            return t.image;
        }
}