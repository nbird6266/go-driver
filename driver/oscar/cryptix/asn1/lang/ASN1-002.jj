// --------------------------------------------------------------------------

void Assignment(): {
}{
    TypeAssignment()
|   OIDAssignment()
}

void TypeAssignment(): {
    String id;
}{
    id = TypeReference()
        {
            Object obj = sTable.get(id);
            if (obj != null)
                if (DEBUG) debug("Re-definition of: "+id+", was: "+obj);
        }
    "::="
    Type(id, true)
}

void OIDAssignment(): {
    String id, oid;
}{
    id = ValueReference()
    <OBJECT> <IDENTIFIER>
    "::="
    oid = ObjectIdentifier()
        {
            sTable.put(id, oid);
        }
}


