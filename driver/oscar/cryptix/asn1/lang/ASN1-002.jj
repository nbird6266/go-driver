void ElementTypeList(String structure): {
}{
    ElementType(structure) ("," ElementType(structure))*
}

void ElementType(String structure): {
    String id = "__LOCAL__";
    ASNObject type = null;
    Object defaultValue = null;
}{
    [ id = Identifier() ]
    type = Type(structure+"."+id, true)
    [
        (
            <OPTIONAL>
                {
                    type.setOptional(true);
                }
//        |   <DEFAULT_TYPE> Value()
        |   <DEFAULT_TYPE> defaultValue = Value()
                {
                    type.setDefaultValue(defaultValue);
                }
        )
            {
                define(structure+"."+id, type);
            }
    ]
}

